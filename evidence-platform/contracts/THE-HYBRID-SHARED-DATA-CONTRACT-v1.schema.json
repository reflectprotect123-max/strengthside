{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehybridsystem.local/schemas/shared-data-contract/v1.0",
  "title": "THE Hybrid System Shared Data Contract v1.0",
  "description": "Canonical machine-readable contract for the five specialist systems, BIG MAC, and Gemini/Gemma advisory and lead-fallback inputs. This schema defines structure and authority boundaries only; it contains no scientific thresholds or coaching rules.",
  "oneOf": [
    {
      "$ref": "#/$defs/EventEnvelope"
    },
    {
      "$ref": "#/$defs/DomainOutputSet"
    },
    {
      "$ref": "#/$defs/CompleteDecisionPacket"
    },
    {
      "$ref": "#/$defs/LLMDecisionRequest"
    },
    {
      "$ref": "#/$defs/LLMDecisionResponse"
    },
    {
      "$ref": "#/$defs/ActionCandidate"
    }
  ],
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "SystemName": {
      "type": "string",
      "enum": [
        "strength",
        "conditioning",
        "nutrition",
        "recovery",
        "coordinator"
      ]
    },
    "ProducerName": {
      "type": "string",
      "enum": [
        "strength",
        "conditioning",
        "nutrition",
        "recovery",
        "coordinator",
        "big_mac",
        "gemini",
        "gemma",
        "adapter",
        "human"
      ]
    },
    "ObservationStatus": {
      "type": "string",
      "enum": [
        "observed",
        "derived",
        "estimated",
        "missing",
        "stale",
        "synthetic_test"
      ]
    },
    "DataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completeness",
        "freshness"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/ObservationStatus"
        },
        "completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "freshness": {
          "type": "string",
          "enum": [
            "current",
            "aging",
            "stale",
            "unknown"
          ]
        },
        "measurement_method": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "protocol_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_from": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        }
      }
    },
    "Uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation"
      ],
      "properties": {
        "representation": {
          "type": "string",
          "enum": [
            "none_declared",
            "point_with_error",
            "interval",
            "distribution",
            "categorical",
            "unknown"
          ]
        },
        "standard_error": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "lower": {
          "type": [
            "number",
            "null"
          ]
        },
        "upper": {
          "type": [
            "number",
            "null"
          ]
        },
        "level": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "distribution_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "measurement",
              "missingness",
              "state",
              "parameter",
              "model",
              "applicability",
              "distribution_shift",
              "decision_ambiguity"
            ]
          }
        }
      }
    },
    "ProvenanceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance_id",
        "record_type",
        "record_hash"
      ],
      "properties": {
        "provenance_id": {
          "$ref": "#/$defs/Identifier"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "source_event",
            "transformation",
            "rule",
            "model",
            "parameter_set",
            "policy",
            "evidence_summary",
            "human_input",
            "llm_input",
            "llm_output"
          ]
        },
        "record_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "version": {
          "oneOf": [
            {
              "$ref": "#/$defs/Version"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ScalarOrRange": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower",
            "upper"
          ],
          "properties": {
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            }
          }
        }
      ]
    },
    "Measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_id",
        "metric_key",
        "unit",
        "time_basis",
        "observed_at",
        "quality",
        "uncertainty",
        "provenance"
      ],
      "properties": {
        "measurement_id": {
          "$ref": "#/$defs/Identifier"
        },
        "metric_key": {
          "$ref": "#/$defs/Identifier"
        },
        "value": {
          "$ref": "#/$defs/ScalarOrRange"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "denominator": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "time_basis": {
          "type": "string",
          "enum": [
            "instant",
            "set",
            "session",
            "day",
            "rolling_window",
            "week",
            "phase",
            "plan"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "quality": {
          "$ref": "#/$defs/DataQuality"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        },
        "method_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ProvenanceRef"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "quality": {
                "properties": {
                  "status": {
                    "enum": [
                      "observed",
                      "derived",
                      "estimated",
                      "synthetic_test"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "quality": {
                "properties": {
                  "status": {
                    "enum": [
                      "missing",
                      "stale"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    },
    "Constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "source_system",
        "level",
        "action_scopes",
        "reason_code",
        "expires_at",
        "provenance"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_system": {
          "$ref": "#/$defs/SystemName"
        },
        "level": {
          "type": "string",
          "enum": [
            "hard",
            "soft",
            "advisory"
          ]
        },
        "action_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "reason_code": {
          "$ref": "#/$defs/Identifier"
        },
        "rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ProvenanceRef"
          }
        }
      }
    },
    "ActionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "target_type",
        "target_id"
      ],
      "properties": {
        "domain": {
          "$ref": "#/$defs/SystemName"
        },
        "target_type": {
          "type": "string",
          "enum": [
            "exercise",
            "strength_session",
            "conditioning_session",
            "nutrition_target",
            "meal_fuel_target",
            "calendar_slot",
            "plan",
            "context_record"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/Identifier"
        },
        "effective_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MetricChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_key",
        "operation",
        "unit"
      ],
      "properties": {
        "metric_key": {
          "$ref": "#/$defs/Identifier"
        },
        "operation": {
          "type": "string",
          "enum": [
            "set",
            "increase_by",
            "decrease_by",
            "multiply_by",
            "move_to",
            "replace_with",
            "no_change"
          ]
        },
        "value": {
          "$ref": "#/$defs/ScalarOrRange"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "bound_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ExpectedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect_key",
        "direction",
        "time_horizon",
        "uncertainty"
      ],
      "properties": {
        "effect_key": {
          "$ref": "#/$defs/Identifier"
        },
        "direction": {
          "type": "string",
          "enum": [
            "increase",
            "decrease",
            "maintain",
            "unknown"
          ]
        },
        "time_horizon": {
          "type": "string",
          "enum": [
            "set",
            "session",
            "day",
            "week",
            "phase",
            "long_term"
          ]
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        }
      }
    },
    "ResourceDemand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_key",
        "direction",
        "magnitude_class"
      ],
      "properties": {
        "resource_key": {
          "$ref": "#/$defs/Identifier"
        },
        "direction": {
          "type": "string",
          "enum": [
            "consumes",
            "preserves",
            "restores",
            "unknown"
          ]
        },
        "magnitude_class": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "moderate",
            "high",
            "unknown"
          ]
        }
      }
    },
    "ActionCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidate_id",
        "source",
        "authority_mode",
        "action_type",
        "target",
        "changes",
        "preconditions",
        "constraints_acknowledged",
        "expected_effects",
        "resource_demands",
        "support_tags",
        "interference_tags",
        "uncertainty",
        "provenance",
        "expires_at"
      ],
      "properties": {
        "kind": {
          "const": "action_candidate"
        },
        "candidate_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source": {
          "$ref": "#/$defs/ProducerName"
        },
        "authority_mode": {
          "type": "string",
          "enum": [
            "deterministic",
            "advisory",
            "lead_fallback",
            "human_authored"
          ]
        },
        "action_type": {
          "type": "string",
          "enum": [
            "keep",
            "hold_progression",
            "bounded_increase",
            "bounded_decrease",
            "change_volume",
            "change_intensity",
            "change_duration",
            "change_density",
            "change_timing",
            "substitute",
            "reschedule",
            "record_missing_information",
            "record_context_only",
            "abstain"
          ]
        },
        "target": {
          "$ref": "#/$defs/ActionTarget"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MetricChange"
          }
        },
        "preconditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "constraints_acknowledged": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "expected_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExpectedEffect"
          }
        },
        "resource_demands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResourceDemand"
          }
        },
        "support_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "interference_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "model_version_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "parameter_set_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "fallback_envelope_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_basis_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ProvenanceRef"
          }
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "authority_mode": {
                "const": "lead_fallback"
              }
            },
            "required": [
              "authority_mode"
            ]
          },
          "then": {
            "required": [
              "fallback_envelope_id"
            ],
            "properties": {
              "source": {
                "enum": [
                  "gemini",
                  "gemma"
                ]
              },
              "fallback_envelope_id": {
                "$ref": "#/$defs/Identifier"
              }
            }
          }
        }
      ]
    },
    "DomainOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "output_id",
        "athlete_scope_id",
        "system",
        "as_of",
        "schema_version",
        "producer_version",
        "producer_artifact_hash",
        "observations",
        "state_features",
        "proposals",
        "constraints",
        "data_quality",
        "uncertainty",
        "provenance",
        "payload_hash"
      ],
      "properties": {
        "kind": {
          "const": "domain_output"
        },
        "output_id": {
          "$ref": "#/$defs/Identifier"
        },
        "athlete_scope_id": {
          "$ref": "#/$defs/Identifier"
        },
        "system": {
          "$ref": "#/$defs/SystemName"
        },
        "as_of": {
          "$ref": "#/$defs/Timestamp"
        },
        "schema_version": {
          "$ref": "#/$defs/Version"
        },
        "producer_version": {
          "$ref": "#/$defs/Version"
        },
        "producer_artifact_hash": {
          "$ref": "#/$defs/Sha256"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Measurement"
          }
        },
        "state_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Measurement"
          }
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionCandidate"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Constraint"
          }
        },
        "data_quality": {
          "$ref": "#/$defs/DataQuality"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ProvenanceRef"
          }
        },
        "source_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "supersedes_output_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload_hash": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "StrengthDomainOutput": {
      "allOf": [
        {
          "$ref": "#/$defs/DomainOutput"
        },
        {
          "properties": {
            "system": {
              "const": "strength"
            }
          }
        }
      ]
    },
    "ConditioningDomainOutput": {
      "allOf": [
        {
          "$ref": "#/$defs/DomainOutput"
        },
        {
          "properties": {
            "system": {
              "const": "conditioning"
            }
          }
        }
      ]
    },
    "NutritionDomainOutput": {
      "allOf": [
        {
          "$ref": "#/$defs/DomainOutput"
        },
        {
          "properties": {
            "system": {
              "const": "nutrition"
            }
          }
        }
      ]
    },
    "RecoveryDomainOutput": {
      "allOf": [
        {
          "$ref": "#/$defs/DomainOutput"
        },
        {
          "properties": {
            "system": {
              "const": "recovery"
            }
          }
        }
      ]
    },
    "CoordinatorDomainOutput": {
      "allOf": [
        {
          "$ref": "#/$defs/DomainOutput"
        },
        {
          "properties": {
            "system": {
              "const": "coordinator"
            }
          }
        }
      ]
    },
    "DomainOutputSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "set_id",
        "athlete_scope_id",
        "as_of",
        "strength",
        "conditioning",
        "nutrition",
        "recovery",
        "coordinator",
        "set_hash"
      ],
      "properties": {
        "kind": {
          "const": "domain_output_set"
        },
        "set_id": {
          "$ref": "#/$defs/Identifier"
        },
        "athlete_scope_id": {
          "$ref": "#/$defs/Identifier"
        },
        "as_of": {
          "$ref": "#/$defs/Timestamp"
        },
        "strength": {
          "$ref": "#/$defs/StrengthDomainOutput"
        },
        "conditioning": {
          "$ref": "#/$defs/ConditioningDomainOutput"
        },
        "nutrition": {
          "$ref": "#/$defs/NutritionDomainOutput"
        },
        "recovery": {
          "$ref": "#/$defs/RecoveryDomainOutput"
        },
        "coordinator": {
          "$ref": "#/$defs/CoordinatorDomainOutput"
        },
        "set_hash": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "WholeAthleteState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "athlete_scope_id",
        "as_of",
        "features",
        "constraints",
        "data_quality",
        "uncertainty",
        "state_hash"
      ],
      "properties": {
        "state_id": {
          "$ref": "#/$defs/Identifier"
        },
        "athlete_scope_id": {
          "$ref": "#/$defs/Identifier"
        },
        "as_of": {
          "$ref": "#/$defs/Timestamp"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Measurement"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
