        "identifiable_data_allowed": {
          "type": "boolean"
        },
        "sensitive_data_allowed": {
          "type": "boolean"
        },
        "excluded_field_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
