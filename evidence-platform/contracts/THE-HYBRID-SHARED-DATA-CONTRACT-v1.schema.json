          "type": "number"
        }
      }
    },
    "FallbackActionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_id",
        "version",
        "allowed_action_types",
        "allowed_target_types",
        "metric_bounds",
        "forbidden_combinations",
        "required_validator_ids",
        "rollback_policy_id",
        "envelope_hash"
      ],
      "properties": {
        "envelope_id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "allowed_action_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "keep",
              "hold_progression",
              "bounded_increase",
              "bounded_decrease",
              "change_volume",
              "change_intensity",
              "change_duration",
              "change_density",
              "change_timing",
              "substitute",
              "reschedule",
              "record_missing_information",
              "record_context_only",
              "abstain"
            ]
          }
        },
        "allowed_target_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "exercise",
              "strength_session",
              "conditioning_session",
              "nutrition_target",
              "meal_fuel_target",
              "calendar_slot",
              "plan",
              "context_record"
            ]
          }
        },
        "metric_bounds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FallbackMetricBound"
          }
        },
        "forbidden_combinations": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/Identifier"
            }
          }
        },
        "required_validator_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "rollback_policy_id": {
          "$ref": "#/$defs/Identifier"
        },
        "envelope_hash": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "CompleteDecisionPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "packet_id",
        "decision_id",
        "athlete_scope_id",
        "created_at",
        "trigger",
        "all_information_declaration",
        "domain_outputs",
        "whole_athlete_state",
        "current_plan",
        "prior_plan_refs",
        "goal_priorities",
        "schedule_context",
        "candidate_ledger",
        "evidence_summaries",
        "policy_refs",
        "privacy_projection",
        "packet_hash"
      ],
      "properties": {
        "kind": {
          "const": "complete_decision_packet"
        },
        "packet_id": {
          "$ref": "#/$defs/Identifier"
        },
        "decision_id": {
          "$ref": "#/$defs/Identifier"
        },
        "athlete_scope_id": {
          "$ref": "#/$defs/Identifier"
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "trigger": {
          "type": "string",
          "enum": [
            "scheduled_review",
            "domain_event",
            "post_session",
            "plan_change",
            "manual_recompute",
            "no_deterministic_answer"
          ]
        },
        "all_information_declaration": {
          "const": "all_decision_relevant_structured_information"
        },
        "domain_outputs": {
          "$ref": "#/$defs/DomainOutputSet"
        },
        "whole_athlete_state": {
          "$ref": "#/$defs/WholeAthleteState"
        },
        "current_plan": {
          "$ref": "#/$defs/PlanRef"
        },
        "prior_plan_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanRef"
          }
        },
        "goal_priorities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/GoalPriority"
          }
        },
        "schedule_context": {
          "$ref": "#/$defs/ScheduleContext"
        },
        "candidate_ledger": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionCandidate"
          }
        },
        "evidence_summaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceSummaryRef"
          }
        },
        "policy_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PolicyRef"
          }
        },
        "privacy_projection": {
          "$ref": "#/$defs/PrivacyProjection"
        },
        "relevant_history_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "recent_outcome_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "data_cutoff_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "packet_hash": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "LLMDecisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_id",
        "mode",
        "lead_provider",
        "routing_policy_id",
        "routing_policy_version",
        "decision_packet",
        "fallback_action_envelope",
        "requested_at",
        "request_hash"
      ],
      "properties": {
        "kind": {
          "const": "llm_decision_request"
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "mode": {
          "type": "string",
          "enum": [
            "advisory",
            "lead_fallback"
          ]
        },
        "trigger_code": {
          "type": "string",
          "enum": [
            "OPTIONAL_ADVISORY",
            "NO_DETERMINISTIC_ANSWER"
          ]
        },
        "lead_provider": {
          "type": "string",
          "enum": [
            "gemini",
            "gemma"
          ]
        },
        "backup_provider": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "gemini",
            "gemma",
            null
          ]
        },
        "routing_policy_id": {
          "$ref": "#/$defs/Identifier"
        },
        "routing_policy_version": {
          "$ref": "#/$defs/Version"
        },
        "decision_packet": {
          "$ref": "#/$defs/CompleteDecisionPacket"
        },
        "fallback_action_envelope": {
          "$ref": "#/$defs/FallbackActionEnvelope"
        },
        "requested_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "request_hash": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "lead_fallback"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "trigger_code"
            ],
            "properties": {
              "trigger_code": {
                "const": "NO_DETERMINISTIC_ANSWER"
              },
              "decision_packet": {
                "allOf": [
                  {
                    "$ref": "#/$defs/CompleteDecisionPacket"
                  },
                  {
                    "properties": {
                      "trigger": {
                        "const": "no_deterministic_answer"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "LLMDecisionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "response_id",
        "request_id",
        "provider",
        "model_id",
        "model_version",
        "mode",
        "write_authority",
        "silent_user_experience",
        "proposed_decision",
        "decision_basis_codes",
        "rationale_summary",
        "uncertainty",
        "alternatives",
        "responded_at",
        "response_hash"
      ],
      "properties": {
        "kind": {
          "const": "llm_decision_response"
        },
        "response_id": {
          "$ref": "#/$defs/Identifier"
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "provider": {
          "type": "string",
          "enum": [
            "gemini",
            "gemma"
          ]
        },
        "model_id": {
          "$ref": "#/$defs/Identifier"
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mode": {
          "type": "string",
          "enum": [
            "advisory",
            "lead_fallback"
          ]
        },
        "write_authority": {
          "const": "none"
        },
        "silent_user_experience": {
          "const": true
        },
        "proposed_decision": {
          "$ref": "#/$defs/ActionCandidate"
        },
        "decision_basis_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "rationale_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Hidden concise decision basis for audit. This is not a request for private chain-of-thought and is never shown during normal use."
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        },
        "alternatives": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/ActionCandidate"
          }
        },
        "responded_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "response_hash": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "lead_fallback"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "proposed_decision": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ActionCandidate"
                  },
                  {
                    "properties": {
                      "authority_mode": {
                        "const": "lead_fallback"
                      },
                      "source": {
                        "enum": [
                          "gemini",
                          "gemma"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "EventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "event_id",
        "athlete_scope_id",
        "producer",
        "event_type",
        "occurred_at",
        "produced_at",
        "schema_version",
        "producer_version",
        "payload",
        "payload_hash",
        "quality",
        "uncertainty",
        "provenance",
        "source_event_ids"
      ],
      "properties": {
        "kind": {
          "const": "event_envelope"
        },
        "event_id": {
          "$ref": "#/$defs/Identifier"
        },
        "athlete_scope_id": {
          "$ref": "#/$defs/Identifier"
        },
        "producer": {
          "$ref": "#/$defs/ProducerName"
        },
        "event_type": {
          "$ref": "#/$defs/Identifier"
        },
        "occurred_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "produced_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "schema_version": {
          "$ref": "#/$defs/Version"
        },
        "producer_version": {
          "$ref": "#/$defs/Version"
        },
        "payload": {
          "type": "object"
        },
        "payload_hash": {
          "$ref": "#/$defs/Sha256",
          "description": "Must be recomputed from canonical payload bytes by the receiving validator; caller assertions are not trusted."
        },
        "quality": {
          "$ref": "#/$defs/DataQuality"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ProvenanceRef"
          }
        },
        "source_event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Identifier"
          }
        },
        "supersedes_event_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
