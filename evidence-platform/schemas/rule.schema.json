{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehybridsystem.example/schemas/rule.schema.json",
  "title": "Rule",
  "description": "Deterministic executable-rule contract with evidence and policy lineage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "purpose",
    "inputs",
    "outputs",
    "status"
    ,"evidence_claim_ids"
    ,"policy_owner"
    ,"tests"
    ,"safety_class"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "formula_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "formula": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "policy_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "policy_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "confidence": {
      "type": "string",
      "minLength": 1
    },
    "unresolved_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": ["draft", "evidence_complete", "policy_owned", "implemented", "tests_passed", "offline_validated", "shadow", "active", "suspended", "deprecated", "retired"]
    },
    "safety_class": {
      "type": "string",
      "minLength": 1
    }
  }
}
