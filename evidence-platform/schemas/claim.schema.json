{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehybridsystem.example/schemas/claim.schema.json",
  "title": "Claim",
  "description": "Atomic claim with evidence and review status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim_text",
    "claim_type",
    "status",
    "provenance"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_text": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "minLength": 1
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "evidence_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "population_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "relative_path",
        "line_start",
        "line_end"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "row": {
          "type": [
            "string",
            "null"
          ]
        },
        "column": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reviewed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_date": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
