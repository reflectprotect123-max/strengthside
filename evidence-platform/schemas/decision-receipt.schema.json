{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehybridsystem.local/schemas/decision-receipt/v2.0",
  "title": "THE Hybrid System Hidden Decision Receipt v2",
  "description": "Immutable, content-addressed, silently stored decision record for deterministic and Gemini/Gemma lead-fallback paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "receipt_version",
    "canonicalization",
    "receipt_id",
    "receipt_hash",
    "decision_id",
    "athlete_scope_id",
    "created_at",
    "decision_mode",
    "prior_receipt_id",
    "previous_receipt_hash",
    "rollback_target_receipt_id",
    "evaluator",
    "artifact_manifest",
    "llm_contribution",
    "action",
    "reason_codes",
    "rationale",
    "validator_results",
    "final_decision",
    "silent_apply_allowed",
    "decision_trace",
    "decision_trace_hash",
    "replay_bundle_hash",
    "silent_user_experience",
    "user_facing_explanation_emitted"
  ],
  "properties": {
    "kind": {
      "const": "decision_receipt"
    },
    "receipt_version": {
      "const": "2.0"
    },
    "canonicalization": {
      "const": "HYBRID-CANONICAL-JSON-v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^REC-V2-[A-F0-9]{24}$"
    },
    "receipt_hash": {
      "$ref": "#/$defs/sha256"
    },
    "decision_id": {
      "$ref": "#/$defs/identifier"
    },
    "athlete_scope_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_mode": {
      "type": "string",
      "enum": [
        "deterministic",
        "lead_fallback",
        "advisory",
        "abstention"
      ]
    },
    "prior_receipt_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^REC-V2-[A-F0-9]{24}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "previous_receipt_hash": {
      "$ref": "#/$defs/sha256"
    },
    "rollback_target_receipt_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^REC-V2-[A-F0-9]{24}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluator_id",
        "evaluator_version"
      ],
      "properties": {
        "evaluator_id": {
          "$ref": "#/$defs/identifier"
        },
        "evaluator_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "artifact_manifest": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "llm_contribution": {
      "oneOf": [
        {
          "$ref": "#/$defs/llmContribution"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "rationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validator_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "final_decision": {
      "type": "object",
      "minProperties": 1
    },
    "silent_apply_allowed": {
      "const": true
    },
    "decision_trace": {
      "type": "object",
      "required": [
        "action",
        "candidate_ledger",
        "validator_results",
        "reason_codes",
        "final_decision",
        "silent_apply_allowed"
      ]
    },
    "decision_trace_hash": {
      "$ref": "#/$defs/sha256"
    },
    "replay_bundle_hash": {
      "$ref": "#/$defs/sha256"
    },
    "silent_user_experience": {
      "const": true
    },
    "user_facing_explanation_emitted": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision_mode": {
            "const": "lead_fallback"
          }
        },
        "required": [
          "decision_mode"
        ]
      },
      "then": {
        "properties": {
          "llm_contribution": {
            "$ref": "#/$defs/llmContribution"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type",
        "version",
        "artifact_hash"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "artifact_type": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "llmContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "model_version",
        "mode",
        "write_authority",
        "silent_user_experience",
        "complete_decision_packet_hash",
        "prompt_hash",
        "request_hash",
        "response_hash",
        "fallback_envelope_hash"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "gemini",
            "gemma"
          ]
        },
        "model_id": {
          "$ref": "#/$defs/identifier"
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "advisory",
            "lead_fallback"
          ]
        },
        "write_authority": {
          "const": "none"
        },
        "silent_user_experience": {
          "const": true
        },
        "complete_decision_packet_hash": {
          "$ref": "#/$defs/sha256"
        },
        "prompt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "request_hash": {
          "$ref": "#/$defs/sha256"
        },
        "response_hash": {
          "$ref": "#/$defs/sha256"
        },
        "fallback_envelope_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
