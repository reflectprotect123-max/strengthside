{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehybridsystem.example/schemas/formula.schema.json",
  "title": "Formula",
  "description": "Versioned formula without invented coefficients.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formula_id",
    "expression",
    "status",
    "source_class",
    "provenance"
  ],
  "properties": {
    "formula_id": {
      "type": "string",
      "minLength": 1
    },
    "expression": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "units": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "source_class": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "relative_path",
        "line_start",
        "line_end"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "relative_path": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "row": {
          "type": [
            "string",
            "null"
          ]
        },
        "column": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  }
}
