{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehybridsystem.example/schemas/metric.schema.json",
  "title": "Metric",
  "description": "Canonical metric semantics and units.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_id",
    "canonical_name",
    "value_type",
    "canonical_unit"
  ],
  "properties": {
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "value_type": {
      "type": "string",
      "minLength": 1
    },
    "canonical_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "numerator": {
      "type": [
        "string",
        "null"
      ]
    },
    "denominator": {
      "type": [
        "string",
        "null"
      ]
    },
    "time_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid_range": {
      "type": [
        "object",
        "null"
      ]
    },
    "measurement_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "type": "string",
      "minLength": 1
    }
  }
}
