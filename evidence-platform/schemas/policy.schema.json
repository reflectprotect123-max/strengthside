{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thehybridsystem.example/schemas/policy.schema.json",
  "title": "Policy",
  "description": "Human-owned product or governance policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "purpose",
    "status",
    "owner"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_due": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
