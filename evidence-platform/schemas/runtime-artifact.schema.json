{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://thehybridsystem.example/schemas/runtime-artifact.schema.json",
  "title":"Promoted runtime artifact",
  "type":"object",
  "additionalProperties":false,
  "required":["artifact_id","artifact_type","version","artifact_path","artifact_hash","trust_origin","llm_tainted","deterministic","status","approval_event_id","rollback_artifact_id"],
  "properties":{
    "artifact_id":{"type":"string","minLength":1},
    "artifact_type":{"enum":["rule_bundle","model","policy_bundle","arbitration_policy"]},
    "version":{"type":"string","minLength":1},
    "artifact_path":{"type":"string","minLength":1},
    "artifact_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "trust_origin":{"const":"human_promoted_verified"},
    "llm_tainted":{"const":false},
    "deterministic":{"const":true},
    "status":{"enum":["shadow","active","suspended","retired"]},
    "approval_event_id":{"type":"string","minLength":1},
    "rollback_artifact_id":{"type":["string","null"]}
  }
}
