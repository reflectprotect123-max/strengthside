{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node scripts/cursor-memory-hook.mjs session-init"
      },
      {
        "command": "node scripts/cursor-memory-hook.mjs context"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node scripts/cursor-memory-hook.mjs observation"
      }
    ],
    "afterShellExecution": [
      {
        "command": "node scripts/cursor-memory-hook.mjs observation"
      }
    ],
    "afterFileEdit": [
      {
        "command": "node scripts/cursor-memory-hook.mjs file-edit"
      }
    ],
    "stop": [
      {
        "command": "node scripts/cursor-memory-hook.mjs summarize"
      }
    ]
  }
}
