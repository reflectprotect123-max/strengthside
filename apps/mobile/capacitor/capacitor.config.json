{
  "appId": "com.hybrid.athlete",
  "appName": "THE Hybrid",
  "webDir": "../preview-site",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera"]
    },
    "CapacitorUpdater": {
      "appId": "com.hybrid.athlete",
      "autoUpdate": false,
      "defaultChannel": "dogfood",
      "appReadyTimeout": 10000,
      "responseTimeout": 20
    }
  }
}
