{
  "appId": "com.hybrid.athlete",
  "appName": "The Hybrid Engine",
  "webDir": "../../athlete/conditioning",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "Camera": {
      "permissions": [
        "camera"
      ]
    },
    "CapacitorUpdater": {
      "appId": "com.hybrid.athlete",
      "autoUpdate": "onlyDownload",
      "defaultChannel": "engine-html",
      "appReadyTimeout": 30000,
      "responseTimeout": 20,
      "allowSetDefaultChannel": false,
      "persistDefaultChannelOnReinstall": false
    },
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "Scanning\u2026",
        "cancel": "Cancel",
        "availableDevices": "Available devices",
        "noDeviceFound": "No device found"
      }
    }
  }
}
