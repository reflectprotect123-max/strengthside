{
  "appId": "com.hybrid.athlete",
  "appName": "THE Hybrid",
  "webDir": "../preview-site",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "Camera": {
      "permissions": ["camera"]
    },
    "CapacitorUpdater": {
      "appId": "com.hybrid.athlete",
      "autoUpdate": true,
      "defaultChannel": "dogfood",
      "appReadyTimeout": 10000,
      "responseTimeout": 20
    },
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "Scanning…",
        "cancel": "Cancel",
        "availableDevices": "Available devices",
        "noDeviceFound": "No device found"
      }
    }
  }
}
