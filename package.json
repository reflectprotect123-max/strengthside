{
  "name": "the-strength-engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "node scripts/bundle-adaptive.mjs && node scripts/bundle-brain.mjs",
    "build:brain": "node scripts/bundle-brain.mjs",
    "sync:brain": "bash scripts/sync-brain-app.sh",
    "check:brain-app": "node scripts/bundle-brain.mjs && node apps/brain-app/checks/brain-app.smoke.mjs",
    "check:whoop-ownership": "node apps/brain-app/checks/whoop-ownership.smoke.mjs",
    "check:whoop-deeplink": "node apps/brain-app/checks/whoop-deeplink.smoke.mjs",
    "check:whoop-live": "node apps/brain-app/checks/whoop-live.smoke.mjs",
    "check:migrations": "node checks/migrations-apply.mjs",
    "check:boot-syntax": "node apps/brain-app/checks/brain-app.smoke.mjs",
    "rematerialize:capgo": "bash scripts/rematerialize-capgo-from-vault.sh",
    "ship:capgo": "bash apps/mobile/capacitor/scripts/ship-capgo.sh",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run check:migrations && pnpm run build && pnpm run check:brain-app && pnpm run check:whoop-ownership && pnpm run check:whoop-deeplink"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
