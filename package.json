{
  "name": "the-strength-engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "node apps/athlete/checks/engine-door.smoke.mjs",
    "sync:athlete": "bash scripts/sync-athlete-app.sh",
    "check:athlete-app": "node scripts/check-engine-half.mjs",
    "check:boot-syntax": "node apps/athlete/checks/engine-door.smoke.mjs",
    "check:openrouter-ownership": "node --test supabase/functions/brain-coach/index.test.mjs",
    "check:whoop-history": "node --test supabase/functions/whoop-sync/history.test.mjs supabase/functions/whoop-sync/observations.test.mjs supabase/functions/_shared/integrations.test.mjs supabase/functions/whoop-connect/return.test.mjs",
    "check:migrations": "node checks/migrations-apply.mjs",
    "rematerialize:capgo": "bash scripts/rematerialize-capgo-from-vault.sh",
    "ship:capgo": "bash apps/mobile/capacitor/scripts/ship-capgo.sh",
    "verify": "pnpm run check:ownership-halves && pnpm run verify:engine && pnpm run check:openrouter-ownership && pnpm run check:whoop-history && pnpm run typecheck && pnpm run test && pnpm run check:migrations && pnpm run build && pnpm run check:browser",
    "verify:engine": "node scripts/check-engine-half.mjs",
    "check:ownership-halves": "node --test scripts/check-ownership-halves.test.mjs && node scripts/setup-cursor-skills.mjs --check",
    "check:browser": "playwright test -c checks/browser/playwright.config.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "1.57.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
