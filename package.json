{
  "name": "the-strength-engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "node scripts/bundle-adaptive.mjs && node scripts/bundle-brain.mjs",
    "build:brain": "node scripts/bundle-brain.mjs",
    "sync:athlete": "bash scripts/sync-athlete-app.sh",
    "check:athlete-app": "node scripts/bundle-brain.mjs && node apps/athlete/checks/athlete-app.smoke.mjs && node apps/athlete/checks/recovery-dial.smoke.mjs && node apps/athlete/checks/capgo-live-update.smoke.mjs",
    "check:boot-syntax": "node apps/athlete/checks/athlete-app.smoke.mjs",
    "check:no-recall": "node apps/athlete/checks/no-recall.smoke.mjs",
    "check:whoop-ownership": "node apps/athlete/checks/whoop-ownership.smoke.mjs",
    "check:openrouter-ownership": "node apps/athlete/checks/openrouter-ownership.smoke.mjs",
    "check:whoop-deeplink": "node apps/athlete/checks/whoop-deeplink.smoke.mjs",
    "check:whoop-live": "node apps/athlete/checks/whoop-live.smoke.mjs",
    "check:coach-ai": "node apps/mobile/prototype/hybrid-app/coach-ai.smoke.mjs",
    "check:coach-loop": "node apps/mobile/prototype/hybrid-app/coach-loop.smoke.mjs",
    "check:coach-clone": "node apps/mobile/prototype/hybrid-app/coach-clone.smoke.mjs",
    "check:coach-session-builder": "node apps/mobile/prototype/hybrid-app/coach-session-builder.smoke.mjs",
    "check:coach-library": "node apps/mobile/prototype/hybrid-app/coach-library.smoke.mjs",
    "check:coach-nutrition": "node apps/mobile/prototype/hybrid-app/coach-nutrition.smoke.mjs",
    "check:coach-program-grid": "node apps/mobile/prototype/hybrid-app/coach-program-grid.smoke.mjs",
    "check:coach-bridge": "node apps/mobile/prototype/hybrid-app/coach-bridge.smoke.mjs",
    "check:coach-calendars": "node apps/mobile/prototype/hybrid-app/coach-calendars.smoke.mjs",
    "check:coach-v1-e2e": "node apps/mobile/prototype/hybrid-app/coach-v1-e2e.smoke.mjs",
    "check:coach-cloud": "node apps/mobile/prototype/hybrid-app/coach-cloud.smoke.mjs",
    "check:coach-portal-athlete": "node apps/mobile/prototype/hybrid-app/coach-portal-athlete.smoke.mjs",
    "check:coach-block-types": "node apps/mobile/prototype/hybrid-app/coach-block-types.smoke.mjs",
    "check:coach-audit-fixes": "node apps/mobile/prototype/hybrid-app/coach-audit-fixes.smoke.mjs",
    "check:exercise-search": "node apps/mobile/prototype/hybrid-app/exercise-search.smoke.mjs",
    "check:log-columns": "node apps/mobile/prototype/hybrid-app/log-columns.smoke.mjs",
    "check:migrations": "node checks/migrations-apply.mjs",
    "rematerialize:capgo": "bash scripts/rematerialize-capgo-from-vault.sh",
    "rematerialize:openrouter": "bash scripts/rematerialize-openrouter-from-vault.sh",
    "set:openrouter-netlify": "bash scripts/rematerialize-openrouter-from-vault.sh && node scripts/set-openrouter-netlify.mjs --deploy-coach",
    "ship:capgo": "bash apps/mobile/capacitor/scripts/ship-capgo.sh",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run check:migrations && pnpm run build && pnpm run check:athlete-app && pnpm run check:no-recall && pnpm run check:whoop-ownership && pnpm run check:openrouter-ownership && pnpm run check:whoop-deeplink && pnpm run check:coach-ai && pnpm run check:log-columns && pnpm run check:exercise-search && pnpm run check:coach-loop && pnpm run check:coach-clone && pnpm run check:coach-session-builder && pnpm run check:coach-library && pnpm run check:coach-nutrition && pnpm run check:coach-program-grid && pnpm run check:coach-bridge && pnpm run check:coach-calendars && pnpm run check:coach-v1-e2e && pnpm run check:coach-cloud && pnpm run check:coach-portal-athlete && pnpm run check:coach-block-types"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
